// 排列树
// 1. 基于交换的排列树
// 优点：原地修改，内存占用小
// 缺点：去重不方便
vector<int>nums = {...};
const int length = nums.size();
void func(int i)  // i表明
{
    if(i == length)
    {
        for(auto & u : nums)
        {
            cout << u << " ";
        }
        cout << endl;
    }
    else
    {
        for(int j = i; j < length; j++)
        {
            swap(nums[i], nums[j]);
            func(i + 1);
            swap(nums[i], nums[j]);
        }
    }
}

