// 547. 省份数量

// 有 n 个城市，其中一些彼此相连，另一些没有相连。如果城市 a 与城市 b 直接相连，且城市 b 与城市 c 直接相连，那么城市 a 与城市 c 间接相连。

// 省份 是一组直接或间接相连的城市，组内不含其他没有相连的城市。

// 给你一个 n x n 的矩阵 isConnected ，其中 isConnected[i][j] = 1 表示第 i 个城市和第 j 个城市直接相连，而 isConnected[i][j] = 0 表示二者不直接相连。

// 返回矩阵中 省份 的数量

// 两种方法都可以 -- DFS -- BFS

#include<iostream>
#include<vector>
#include<queue>
using namespace std;

int BFSProvince(vector<vector<int>>map) {
	int n = map.size();
	vector<bool>isvisited(n, 0);
	queue<int>q;
	int province = 0;
	for (int i = 0; i < n; i++) {
		if (isvisited[i] == 0) {
			province++;
			q.push(i);
			isvisited[i] = 1;
			while (!q.empty()) {
				int front = q.front();
				q.pop();
				for (int j = 0; j < n; j++) {
					if (isvisited[j] == 0 && map[front][j] == 1) {
						q.push(j);
						isvisited[j] = 1;
					}
				}
			}
		}
	}
	return province;
}

int DFSProvince(vector<vector<int>>map) {
	int province = 0;
	vector<bool>visited(map.size(), 0);
	for (int i = 0; i < map.size(); i++) {
		if (visited[i] == 0) {
			province++;
			DFS(i, map, visited);
		}
	}
	return province;
}

void DFS(int start, vector<vector<int>>map, vector<bool>&visited) {
	if (visited[start] == 1) {
		return;
	}
	visited[start] = 1;
	for (int i = 0; i < map.size(); i++) {
		if (map[start][i] == 1) {
			DFS(i, map, visited);
		}
	}
}

int main() {
	vector<vector<int>> test1 = 
	{
		{1, 1, 0},
		{1, 1, 0},
		{0, 0, 1}
	};
	cout << BFSProvince(test1) << endl;
	return 0;
}